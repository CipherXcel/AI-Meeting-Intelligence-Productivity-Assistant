PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_calendar_app_db
APP_URL=http://localhost:3000

# Authentication (Descope)
DESCOPE_PROJECT_ID=your_descope_project_id
DESCOPE_MANAGEMENT_KEY=your_descope_management_key
DESCOPE_CALENDAR_CONNECTION_ID=google-calendar

# LLM Providers (Google Gemini)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# AWS Cloud Storage Configuration (S3 & Versioning)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=meetagent-cloud-storage-bucket

SERVER_URL=http://localhost:4000
