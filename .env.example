# Copy to backend/.env for local development. Compose reads a copy at root.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://meetagent:change-this-database-password@localhost:5443/meetagent
POSTGRES_PASSWORD=change-this-database-password
APP_URL=http://localhost:3000
PUBLIC_URL=http://localhost:4000
# Generate independent secrets: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-random-hex-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: leave bucket empty for persistent local filesystem storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
UPLOAD_DIR=uploads
# Production Caddy hostname
DOMAIN=localhost
